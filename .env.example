# ============================================
# 資料目錄設定
# ============================================
DATA_PATH=./data

# ============================================
# PostgreSQL 資料庫設定
# ============================================
POSTGRES_VERSION=18-alpine
POSTGRES_USER=changeUser
POSTGRES_PASSWORD=changePassword
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=changeUser
POSTGRES_NON_ROOT_PASSWORD=changePassword

# ============================================
# Redis 設定
# ============================================
REDIS_MAX_MEMORY=512M

# ============================================
# n8n 基本設定
# ============================================
N8N_VERSION=latest
DOMAIN_NAME=example.com
N8N_PATH=/
GENERIC_TIMEZONE=Asia/Taipei
N8N_ENCRYPTION_KEY=changeKey

# ============================================
# n8n Runner 設定
# ============================================
N8N_RUNNERS_VERSION=latest
N8N_RUNNERS_AUTH_TOKEN=changeAuthToken

# Runner 建置選項 (可選)
NODE_INSTALL=
PYTHON_INSTALL=
NODE_BUILTIN=crypt
PYTHON_STDLIB=json

# ============================================
# Watchtower 自動更新設定
# ============================================
WATCHTOWER_ENABLE=true
